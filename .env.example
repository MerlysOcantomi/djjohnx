# Plantilla de variables de entorno de DJ JOHNX.
# Copia este archivo a .env.local y rellena los valores.
# NUNCA escribas aqui valores reales: este archivo si se sube al repositorio.

# --- Privadas: no deben llegar nunca al navegador ---

# Cadena de conexion de Neon Postgres.
# Vercel > Storage > Neon > .env.local
DATABASE_URL=

# Token de lectura/escritura de Vercel Blob, para las imagenes.
BLOB_READ_WRITE_TOKEN=

# Contrasena de acceso al panel /admin.
# Debe ser nueva y exclusiva de este panel: no reutilices otras.
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesion (HMAC-SHA256).
# Minimo 32 bytes aleatorios; recomendado 48 o 64.
# Generalo con:  openssl rand -base64 48
# No es la contrasena del panel: debe ser un valor distinto de ADMIN_PASSWORD.
# Guardalo solo en las variables de entorno de Vercel.
SESSION_SECRET=

# --- Publica: se incrusta en el navegador ---

# Dominio canonico. Se usa para metadataBase, canonical, sitemap y robots.
NEXT_PUBLIC_APP_URL=https://djjohnx.com
